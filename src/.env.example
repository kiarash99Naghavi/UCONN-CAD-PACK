# Copy this file to .env and fill in your key.
#   cp ourimplementation/.env.example ourimplementation/.env
# .env is gitignored — never commit your key.
#
# Every setting below is optional except the key: config.py carries the same
# default for each one. A value here WINS over the code default, and a real
# environment variable wins over both (the loader uses setdefault), which is
# how the per-run overrides further down work.

# Paste the WHOLE key, replacing everything after the "=" (it already starts
# with sk-, so don't leave a second one behind: sk-sk-... gives a 401).
OPENAI_API_KEY=sk-...

# Regional endpoint. Accounts provisioned in a specific region reject requests
# to the global hostname with:
#   401 incorrect_hostname — "make your request to us.api.openai.com"
# If you see that, uncomment the line matching your account's region.
# OPENAI_BASE_URL=https://us.api.openai.com/v1
# OPENAI_BASE_URL=https://eu.api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# One model per agent role — they do different work and do not need the same
# model. The executor writes the CadQuery and benefits most from a strong (or
# code-specialised) model; QA mostly reads a measured numbers block and renders
# a verdict, so a mini model does it at a fraction of the price. Cost
# efficiency is explicitly judged.
MODEL_STRATEGIST=gpt-5.2-2025-12-11
MODEL_EXECUTOR=gpt-5.2-2025-12-11
MODEL_QA=gpt-5.4-mini-2026-03-17

# TESTING runs should not pay production prices. Override per command instead
# of editing this file, so the committed config keeps describing the real runs:
#   MODEL_STRATEGIST=gpt-5.4-mini MODEL_EXECUTOR=gpt-5.4-mini \
#   MODEL_QA=gpt-5.4-mini uv run python -m ourimplementation.pipeline \
#     --request <rid> --user-id <tag> --score
# gpt-5.4-mini is verified against this pipeline's two hard requirements —
# JSON-object replies and vision. Mini runs are good for checking MECHANISM
# (did it target the right body, did it no-op, did the fallback fire); their
# SCORES are not comparable to a production-model run.

# low | medium | high. This is the biggest cost dial in the whole pipeline:
# measured on this project, reasoning is 87-93% of output tokens and output is
# ~85% of spend, so effort matters far more than prompt size.
REASONING_EFFORT=medium

# $ per 1M tokens, used for the cost estimate in settings.json. These are flat
# rates — cached input is recorded per run (token_counts.cached_input_tokens)
# but deliberately NOT discounted here, since guessing a cached rate would make
# the reported cost a fiction.
COST_PER_1M_INPUT=1.75
COST_PER_1M_OUTPUT=14.00

# Loop budgets. Each attempt is a full LLM call, so these multiply cost
# directly; token_counts.per_role in settings.json says which role is actually
# spending it.
MAX_SUBTASKS=5
# Attempts that produced judgeable geometry (a real design decision that a gate
# or QA then rejected).
MAX_ATTEMPTS_PER_SUBTASK=3
# Extra headroom for attempts that produced nothing to judge — a traceback, a
# no-op. 0 means the ceiling equals the design budget above: once a sub-goal
# starts no-opping it rarely recovers, and the extra attempts only repeat the
# same failure.
MAX_BARREN_RETRIES=0
# When every attempt of a sub-goal is rejected and nothing was kept, the
# failures go back to the strategist for a new strategy and the sub-goal
# re-runs. This caps how many times that can happen per sub-goal.
MAX_REPLANS=2
SCRIPT_TIMEOUT_S=180
RENDER_SIZE=512

# The cadquery-editor skill: only the recipe sections a sub-goal's tags select
# are ever sent. OFF by default — the block had grown to ~4.1k tokens, larger
# than the geometry index itself, and whether it earns that is an open A/B.
# Each run records the setting in its experiment.json, so rows are self-labelling.
USE_SKILL_RECIPES=0
RECIPES_MAX_TOKENS=4100
# SKILLS_DIR=../Skills

# Renders sent to the executor (QA always gets the full set). Turning them off
# is a legitimate input-token experiment — the executor selects by measured
# numbers from the geometry index, so the views orient it rather than being
# its instrument.
SHOW_EXECUTOR_VIEWS=1

# Name this pipeline writes results under: results/runs/<OUR_USER_ID>/ and the
# userId recorded in settings.json. --user-id on the command line overrides it.
# OUR_USER_ID=ours_adk-router
